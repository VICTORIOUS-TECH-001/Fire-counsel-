# Do not track dependency trees, local emulator state, or Python bytecode.
node_modules/
__pycache__/
*.py[cod]
.firebase/
firebase-debug.log
ui-debug.log

# Obsolete local override. The browser loads firebase/firebase-config.mjs.
# Web API keys identify an app; the real apiKey belongs in that committed file.
/firebase/firebase-config.local.mjs

# Test outputs and developer-only secrets/configuration.
/test-results/
/playwright-report/
*.log
.env
.env.*
!.env.example
*.service-account.json
*serviceAccount*.json

# Scratch dependency reviews and locally unpacked test runtimes.
.cache/
