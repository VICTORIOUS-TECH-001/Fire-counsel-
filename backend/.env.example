# Copy to .env for local development. Never commit real secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FIREBASE_PROJECT_ID=fire-counsel
# Prefer a secret-file mount in production. This JSON variable is for local setup only.
FIREBASE_SERVICE_ACCOUNT_JSON=
DATABASE_URL=
# Comma-separated exact frontend origins. Leave blank until deployment URL is known.
CORS_ORIGINS=
ENVIRONMENT=development
