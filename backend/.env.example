# Copy this file to .env and supply real values.
# Never commit .env or service-account credentials.

NODE_ENV=development
PORT=4000

# Neon PostgreSQL connection string (use the pooled connection string).
# The API enforces TLS certificate and hostname validation.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full

# Comma-separated frontend origins allowed to call this API.
# Add your local frontend URL and deployed FIRE COUNSEL URL.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Firebase Admin service account JSON as a single-line JSON string.
# Keep this secret in your deployment provider's environment settings.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Must match the project_id in the service account. Never put an Admin key here.
FIREBASE_PROJECT_ID=fire-counsel
