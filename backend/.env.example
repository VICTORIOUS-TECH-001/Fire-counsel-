# Copy this file to .env and supply real values.
# Never commit .env or service-account credentials.

NODE_ENV=development
PORT=4000

# Neon PostgreSQL connection string (use the pooled connection string).
# The API enforces TLS certificate and hostname validation.
# Leave empty for a local-only preview. Example format (not a usable credential):
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full
DATABASE_URL=

# Comma-separated frontend origins allowed to call this API.
# Add your local frontend URL and deployed FIRE COUNSEL URL.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Firebase Admin service account JSON as a single-line JSON string.
# Keep this secret in your deployment provider's environment settings.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Must match the project_id in the service account. Never put an Admin key here.
FIREBASE_PROJECT_ID=fire-counsel

# OFF by default. Before enabling: compare live schema privately, review/run
# migrations/001_student_profiles.sql on disposable staging and verify access.
# This enables self-service profiles + mandatory installation checks on student
# material/search APIs. It never assigns courses, membership, payment or roles.
STUDENT_PROFILES_ENABLED=false

# Optional exact reverse-proxy IPs/CIDRs ONLY after reviewing the actual network
# path and header replacement. Empty = ignore all forwarded IP headers.
# Never use true, a hop count, wildcards, 0.0.0.0/0 or ::/0.
# For the LOCAL Python helper only, 127.0.0.1/32 trusts the helper's observed peer
# (which can still be an Arena gateway, not the student's public IP).
TRUSTED_PROXY_CIDRS=
