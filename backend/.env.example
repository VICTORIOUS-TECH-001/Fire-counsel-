# Copy this file to .env and supply real values.
# Never commit .env or service-account credentials.

NODE_ENV=development
PORT=4000

# Neon PostgreSQL connection string (use the pooled connection string).
# The API enforces TLS certificate and hostname validation.
# Leave empty for a local-only preview. Example format (not a usable credential):
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full
DATABASE_URL=

# Comma-separated frontend origins allowed to call this API.
# Add your local frontend URL and deployed FIRE COUNSEL URL.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Firebase Admin service account JSON as a single-line JSON string.
# Keep this secret in your deployment provider's environment settings.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Must match the project_id in the service account. Never put an Admin key here.
FIREBASE_PROJECT_ID=fire-counsel

# OFF by default. Before enabling: compare live schema privately, review/run
# migrations/001_student_profiles.sql on disposable staging and verify access.
# This enables self-service profiles + mandatory installation checks on student
# material/search APIs. It never assigns courses, membership, payment or roles.
STUDENT_PROFILES_ENABLED=false

# Optional exact reverse-proxy IPs/CIDRs ONLY after reviewing the actual network
# path and header replacement. Empty = ignore all forwarded IP headers.
# Never use true, a hop count, wildcards, 0.0.0.0/0 or ::/0.
# For the LOCAL Python helper only, 127.0.0.1/32 trusts the helper's observed peer
# (which can still be an Arena gateway, not the student's public IP).
TRUSTED_PROXY_CIDRS=

# --- AI writers and independent online search (server-side only) ---
# Full setup/troubleshooting: ../DEPLOYMENT.md section 5.
# At least one writer key is required for answers. Unused providers stay blank.
# Groq text answers do not require Gemini. These Groq models cannot read photos/PDFs.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# At least one independent search key is recommended; both enable failover.
# A writer key alone (other than usable Gemini grounding) does not search the web.
# Each provider needs active API access/quota; no free allowance is assumed.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# This example prefers Groq. With no override the code uses gemini,groq,openrouter.
# Orders change priority only: omitted recognised providers are appended;
# providers without keys are skipped. Remove a key to disable that provider.
AI_WRITER_PROVIDER_ORDER=groq,gemini,openrouter
WEB_SEARCH_PROVIDER_ORDER=tavily,brave,gemini
# Total retrieval budget and per-provider budget, in milliseconds.
WEB_SEARCH_TIMEOUT_MS=45000
WEB_SEARCH_PROVIDER_TIMEOUT_MS=12000
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=8
BRAVE_MAX_RESULTS=8
# Conservative Groq prompt + completion budget; match the actual account limit.
GROQ_TOKENS_PER_MINUTE=8000
# Fresh retrieval by default. Opt-in reuse is account-scoped, in memory only,
# never caches attachments/failures, and shows the original retrieval time.
AI_RESEARCH_CACHE_MINUTES=0
# Optional comma-separated model IDs supported by YOUR provider account.
# GROQ_MODELS=
# GEMINI_MODELS=
# GEMINI_SEARCH_MODELS=
# OPENROUTER_MODELS=
# Google-verified emails eligible for the protected one-time admin claim flow.
ADMIN_EMAILS=
AI_TIMEZONE=Africa/Lagos
