rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Public homepage content only. Secrets and private account data never belong here.
    match /siteContent/{documentId} {
      allow read: if true;
      // Publish through a server that validates an admin claim and the JSON schema.
      allow create, update, delete: if false;
    }

    // Account, quota, entitlement and usage changes are server-only.
    // The backend must return each student only their own safe account summary.
    match /accounts/{uid} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /aiQuotaPolicies/{policyId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /aiEntitlements/{uid} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /aiUsage/{usageId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /adminAudit/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Provider API keys are not Firestore documents. This deny-all fallback also
    // blocks client access to any collection not intentionally listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
